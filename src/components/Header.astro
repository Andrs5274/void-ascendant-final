---
const navItems = [
  { label: "Inicio", href: "#inicio" },
  { label: "Agentes", href: "#agentes" },
  { label: "Modos", href: "#modos" },
  { label: "Recompensas", href: "#recompensas" },
  { label: "FAQ", href: "#faq" },
];
---

<header
  class="fixed left-0 top-0 z-50 w-full border-b border-white/10 bg-black/80 backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4"
  >
    <a
      href="#inicio"
      class="text-xl font-black tracking-widest text-white"
    >
      VOID
      <span class="text-green-400">
        ASCENDANT
      </span>
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="text-sm font-medium text-zinc-400 transition hover:text-green-400"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="#preregistro"
      class="rounded-md bg-green-400 px-5 py-2 text-sm font-bold text-black transition hover:bg-green-300"
    >
      PRERREGISTRO
    </a>
  </nav>
</header>