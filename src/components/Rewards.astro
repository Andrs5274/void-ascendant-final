---
type Reward = {
  title: string;
  description: string;
  requirement: string;
};

const rewards: Reward[] = [
  {
    title: "CRÉDITOS DE INICIO",
    description:
      "Recibe recursos especiales para comenzar tu aventura y mejorar a tus primeros agentes.",
    requirement: "PRERREGISTRO",
  },
  {
    title: "INSIGNIA DEL VACÍO",
    description:
      "Una insignia exclusiva para los jugadores que formen parte de la primera generación de Void Ascendant.",
    requirement: "25K REGISTROS",
  },
  {
    title: "SUMINISTROS ÉLITE",
    description:
      "Obtén materiales especiales, créditos adicionales y objetos de mejora para tus agentes.",
    requirement: "50K REGISTROS",
  },
  {
    title: "RECOMPENSA LEGENDARIA",
    description:
      "Desbloquea una recompensa exclusiva cuando la comunidad alcance el objetivo máximo de prerregistros.",
    requirement: "100K REGISTROS",
  },
];
---

<section
  id="recompensas"
  class="bg-zinc-950 px-6 py-24 text-white"
>
  <div class="mx-auto max-w-7xl">

    <div class="mb-14 text-center">
      <p
        class="mb-3 text-sm font-bold tracking-[0.4em] text-green-400"
      >
        OBJETIVOS DE LA COMUNIDAD
      </p>

      <h2
        class="text-4xl font-black sm:text-6xl"
      >
        RECOMPENSAS
      </h2>

      <p
        class="mx-auto mt-5 max-w-2xl leading-7 text-zinc-400"
      >
        Cuantos más jugadores se unan al prerregistro,
        mejores serán las recompensas disponibles para toda la comunidad.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        rewards.map((reward, index) => (
          <article
            class="group relative overflow-hidden rounded-2xl border border-white/10 bg-black p-7 transition duration-300 hover:-translate-y-2 hover:border-green-400"
          >
            <div
              class="mb-8 flex h-12 w-12 items-center justify-center rounded-lg bg-green-400 font-black text-black"
            >
              {String(index + 1).padStart(2, "0")}
            </div>

            <p
              class="mb-3 text-xs font-bold tracking-[0.25em] text-green-400"
            >
              {reward.requirement}
            </p>

            <h3
              class="text-xl font-black"
            >
              {reward.title}
            </h3>

            <p
              class="mt-4 leading-7 text-zinc-400"
            >
              {reward.description}
            </p>

            <div
              class="absolute bottom-0 left-0 h-1 w-0 bg-green-400 transition-all duration-300 group-hover:w-full"
            >
            </div>
          </article>
        ))
      }
    </div>

  </div>
</section>