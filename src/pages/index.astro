---
import Layout from "../layouts/Layout.astro";
import ResponsiveHeader from "../components/ResponsiveHeader.tsx";
import Hero from "../components/Hero.astro";
import Agents from "../components/Agents.tsx";
import GameModes from "../components/GameModes.astro";
import Rewards from "../components/Rewards.astro";
import RegistrationForm from "../components/RegistrationForm.tsx";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";

const gameTitle = "VOID ASCENDANT";
const subtitle = "EL VACÍO TE ESTÁ LLAMANDO";
---

<Layout
  title={gameTitle}
  description="Void Ascendant, una experiencia de acción y ciencia ficción."
>
  <ResponsiveHeader client:load />

  <main>
    <Hero
      title={gameTitle}
      subtitle={subtitle}
    />

    <Agents client:load />

    <GameModes />

    <Rewards />

    <RegistrationForm client:load />

    <FAQ />
  </main>

  <Footer />
</Layout>